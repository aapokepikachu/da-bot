# Copy this file to ".env" for local development and fill in real values.
# NEVER commit your real ".env" file to GitHub.

# --- Required ---

# Your Discord bot's token from the Discord Developer Portal (Bot tab).
DISCORD_TOKEN=your_bot_token_here

# --- Optional, but recommended ---

# Your own Discord user ID (numeric). Used to build the /aboutme profile link.
CREATOR_USER_ID=your_discord_user_id_here

# Restrict the bot to a single Discord server (numeric guild ID).
# Leave blank to allow the bot to respond in any server it's added to.
ALLOWED_GUILD_ID=your_server_id_here

# The server's custom :Milo: emoji. Defaults to the real one if left blank.
# In Discord, type a backslash before the emoji (e.g. "\:Milo:") and send
# it -- Discord replaces it with the raw code you can paste here.
MILO_EMOJI=<:Milo:1554818642804482078>

# Optional: free API key from thecatapi.com/signup, needed for /catbreed.
# TheCatAPI started requiring this on its breeds endpoint in late Sept 2026.
# Leave blank to disable /catbreed (it'll tell users clearly why).
CAT_API_KEY=

# Optional: free API key from console.groq.com, needed for /ask.
# NOT related to xAI (Grok) or SpaceX despite the similar-sounding name --
# sign up at console.groq.com specifically. No credit card required.
# Leave blank to disable /ask (it'll tell users clearly why).
GROQ_API_KEY=

# Optional: which Groq model /ask uses. Leave blank for the default
# (openai/gpt-oss-20b). Groq retires models over time (llama-3.1-8b-instant was
# shut down Aug 16, 2026) -- if /ask starts failing with a 404, put a current
# model name from console.groq.com/docs/models here.
GROQ_MODEL=

# Optional: channel ID(s) where /ask is allowed, comma-separated, e.g.
#   ASK_CHANNEL_IDS=111111111111111111,222222222222222222
# Keeps /ask out of busy channels like #spam so it doesn't use up the shared
# daily AI limit. Anywhere else, /ask politely points people to these channels.
# Threads inside an allowed channel are allowed too. Leave blank = every channel.
# (Discord Settings -> Advanced -> Developer Mode, then right-click a channel
# -> Copy Channel ID.)
ASK_CHANNEL_IDS=

# --- Optional features (each is skipped/disabled if left blank) ---

# Channel ID where new-member welcome messages get posted.
# Leave blank to disable the welcome message feature entirely.
WELCOME_CHANNEL_ID=your_welcome_channel_id_here

# The Manager role ID. Can use BOTH hidden commands: "?send <message>" and
# "?rolemenu" (which posts the self-assign roles menu).
# Leave blank to disable ?rolemenu entirely.
MANAGER_ROLE_ID=1532265448056422520

# A second, more limited role ID (e.g. a role named "Milo"). Can use
# "?send <message>" ONLY -- not "?rolemenu", which stays Manager-only.
# Leave blank if only the Manager role should be able to use ?send.
MILO_ROLE_ID=

# Self-assignable roles offered by /rolemenu, as:
#   ROLE_ID|Label|Emoji,ROLE_ID|Label|Emoji,...
# Emoji is optional per entry (just leave that segment blank: "ROLE_ID|Label|").
# A pipe "|" is used instead of a colon so custom emoji codes like
# <:Gamer:123456789012345678> (which already contain colons) parse cleanly.
# Leave blank to disable /rolemenu entirely.
# Example:
# SELF_ROLES=111111111111111111|Gamer|🎮,222222222222222222|Artist|🎨,333333333333333333|Night Owl|🦉
SELF_ROLES=

# --- Render-managed (usually don't set this yourself) ---

# Port for the built-in HTTP health server. Render sets this automatically.
PORT=10000

# ---------------------------------------------------------------------------
# Optional: the 🧠 "Think harder" / 🔮 "Second opinion" buttons under /ask answers.
# Same GROQ_API_KEY as above -- you only name the extra models. Each model has
# its OWN separate free allowance on Groq, so these never use up /ask's.
# Leave a model blank to leave that button out.
# ---------------------------------------------------------------------------
# Smarter model for "Think harder". Recommended: openai/gpt-oss-120b
GROQ_THINK_MODEL=
# A different model for "Second opinion". Recommended: qwen/qwen3.8-27b
# (a PREVIEW model on Groq -- it can be withdrawn at short notice)
GROQ_SECOND_MODEL=

# Tries per person per day / tries for the WHOLE server per day, per button.
# Defaults are sized for a ~10-person server. Leave blank to keep the defaults.
# Rule of thumb: global limit x ~3,500 tokens must stay under Groq's free
# 200,000 tokens/day per model (so global limit <= ~55).
THINK_USER_DAILY=3
THINK_GLOBAL_DAILY=40
SECOND_USER_DAILY=2
SECOND_GLOBAL_DAILY=25

# "Daily" limits reset at midnight in this timezone (IANA name). Default Asia/Kolkata.
LIMIT_RESET_TZ=Asia/Kolkata

# Optional but recommended: Upstash Redis (free) so the daily limits SURVIVE
# restarts/redeploys. Without these, limits are kept in memory and reset
# whenever Milo restarts. Create a free database at upstash.com, then copy the
# two values from its "REST API" section. Treat the token like a password.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Points, /slots, /points, /leaderboard  (see README section 15)
# Points are kept in memory and saved to Upstash (the UPSTASH_* variables above)
# every few minutes, on shutdown, and when a Manager types ?updateDB.
# WITHOUT Upstash, points still work but are wiped on every restart/redeploy.
# ---------------------------------------------------------------------------
# Channel ID(s) where /slots is allowed, comma-separated. Keeps spins out of
# #general. Blank = anywhere. Threads inside an allowed channel are allowed too.
SLOTS_CHANNEL_IDS=

# Free spins per person per day, bonus spins per day, and points per bonus spin.
# Rule of thumb: each spin returns about 1.2 points on average.
SLOTS_FREE_SPINS=25
# Bonus spins come in packs: PACK_COST points buys PACK_SPINS spins. PAID_SPINS is the most
# bonus spins per person per day (rounded down to whole packs). The old SLOTS_SPIN_COST is no longer used.
SLOTS_PAID_SPINS=20
SLOTS_PACK_COST=5
SLOTS_PACK_SPINS=10
# The spin (since your last 777) that is guaranteed to be a 777:
SLOTS_JACKPOT_PITY_AT=200

# Total points a person must have EARNED to appear on /leaderboard. At ~30
# points a day, 1000 takes about a month -- try 300-500 for a livelier board.
LEADERBOARD_MIN_POINTS=1000

# How often changed points are saved to Upstash, in minutes.
POINTS_SAVE_MINUTES=5

# ---------------------------------------------------------------------------
# Gamblin -- the Manager-only ?gamblin betting event (README section 16)
# ---------------------------------------------------------------------------
# The channel Gamblin runs in. Deny "Send Messages" for @everyone there so people
# can only use the buttons. Milo needs Send Messages + Mention Everyone.
GAMBLIN_CHANNEL_ID=

# Optional tuning (defaults shown):
# GAMBLIN_LOBBY_SECONDS=90
# GAMBLIN_ROUNDS=3
# GAMBLIN_BET_SECONDS=40
# GAMBLIN_REEL_SECONDS=25
# GAMBLIN_MIN_BET=5
# GAMBLIN_MAX_BET=100
# GAMBLIN_MAX_PLAYERS=25
# GAMBLIN_MAX_MULT=500

# ---------------------------------------------------------------------------
# Manager log channel (optional) -- README section 17
# ---------------------------------------------------------------------------
# A private staff channel. Milo logs ?give/?set/?undo, Gamblin results, save
# problems, online/offline, and everyone's points at the nightly reset there.
# Give Milo Send Messages + Embed Links in it. Leave empty to turn logging off.
LOG_CHANNEL_ID=

# ---------------------------------------------------------------------------
# /join games (README section 18)
# ---------------------------------------------------------------------------
# The games /join offers, with the role that gets pinged:
#   ROLE_ID|Name|Emoji|Call to action,ROLE_ID|Name|Emoji|Call to action
# Emoji and call-to-action are optional (no commas in the call to action).
# Leave this unset and you get the original two (VBL + Minecraft) unchanged.
# JOIN_GAMES=1532265584069185597|VBL|🏐|Join the lobby now!,1536962762952146944|Minecraft||Join the Server now!

# ---------------------------------------------------------------------------
# Blackjack Gamblin -- started from ?gamblin (README section 19). Uses GAMBLIN_CHANNEL_ID.
# ---------------------------------------------------------------------------
# GAMBLIN_BJ_ROUNDS=5
# GAMBLIN_BJ_BET_SECONDS=30
# GAMBLIN_BJ_TURN_SECONDS=40

# ---------------------------------------------------------------------------
# Duck Race and Roulette -- started from ?gamblin (README sections 20 and 21).
# They use GAMBLIN_CHANNEL_ID and the shared GAMBLIN_MIN_BET / GAMBLIN_MAX_BET.
# ---------------------------------------------------------------------------
# GAMBLIN_DUCK_ROUNDS=3
# GAMBLIN_DUCK_BET_SECONDS=30
# GAMBLIN_RL_ROUNDS=4
# GAMBLIN_RL_BET_SECONDS=40

# ---------------------------------------------------------------------------
# /daily and /pay (README section 22) -- all optional, defaults shown
# ---------------------------------------------------------------------------
# DAILY_BASE=15
# DAILY_STREAK_BONUS=5
# DAILY_STREAK_CAP=7
# DAILY_WEEK_BONUS=50
# PAY_DAILY_CAP=200

# ---------------------------------------------------------------------------
# Midnight announcement (README section 23)
# ---------------------------------------------------------------------------
# Your #general channel. At 12:00 AM (LIMIT_RESET_TZ) Milo posts "everything has reset"
# with an @everyone ping. Milo needs Send Messages, Embed Links and Mention Everyone there.
# Leave empty to turn it off.
RESET_ANNOUNCE_CHANNEL_ID=

# ---------------------------------------------------------------------------
# What the points are called (README section 25) -- all optional
# ---------------------------------------------------------------------------
# The plural name shown everywhere, e.g. Milo Chips. Default: points
# POINTS_NAME=Milo Chips
# An emoji shown with it: a custom emoji ID (digits only), a full <:name:id> / <a:name:id>,
# or a normal emoji like 🪙. Default: none
# POINTS_EMOJI=
# Only if "1 chip" comes out wrong (it drops a trailing "s"), e.g. POINTS_NAME_SINGULAR=Gas
# POINTS_NAME_SINGULAR=

# ---------------------------------------------------------------------------
# Daily lottery -- /lottery (README section 24) -- all optional, defaults shown
# ---------------------------------------------------------------------------
# LOTTERY_TICKET_COST=10
# LOTTERY_MAX_TICKETS=5
# LOTTERY_JACKPOT_SEED=50
# Where the nightly results post (falls back to RESET_ANNOUNCE_CHANNEL_ID):
# LOTTERY_CHANNEL_ID=

# ---------------------------------------------------------------------------
# /react gif sources (README section 26) -- all optional
# ---------------------------------------------------------------------------
# Milo picks randomly between otakugifs, nekos.best, gifukai, purrbot and waifupics.
# Switch whole sources off:   REACT_DISABLE=purrbot,waifupics
# Hide single reactions:      REACT_BLOCK=bully,glomp
# The name Milo introduces itself with when asking those sites for gifs
# (nekos.best requires a real one; the default is fine):
# API_USER_AGENT=MiloBot/1.0 (https://github.com/you/da-bot)

