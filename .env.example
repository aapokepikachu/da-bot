# Copy this file to ".env" for local development and fill in real values.
# NEVER commit your real ".env" file to GitHub.

# --- Required ---

# Your Discord bot's token from the Discord Developer Portal (Bot tab).
DISCORD_TOKEN=your_bot_token_here

# --- Optional, but recommended ---

# Your own Discord user ID (numeric). Used to build the /aboutme profile link.
CREATOR_USER_ID=your_discord_user_id_here

# Restrict the bot to a single Discord server (numeric guild ID).
# Leave blank to allow the bot to respond in any server it's added to.
ALLOWED_GUILD_ID=your_server_id_here

# The server's custom :Milo: emoji. Defaults to the real one if left blank.
# In Discord, type a backslash before the emoji (e.g. "\:Milo:") and send
# it -- Discord replaces it with the raw code you can paste here.
MILO_EMOJI=<:Milo:1554818642804482078>

# Optional: free API key from thecatapi.com/signup, needed for /catbreed.
# TheCatAPI started requiring this on its breeds endpoint in late Sept 2026.
# Leave blank to disable /catbreed (it'll tell users clearly why).
CAT_API_KEY=

# Optional: free API key from console.groq.com, needed for /ask.
# NOT related to xAI (Grok) or SpaceX despite the similar-sounding name --
# sign up at console.groq.com specifically. No credit card required.
# Leave blank to disable /ask (it'll tell users clearly why).
GROQ_API_KEY=

# Optional: which Groq model /ask uses. Leave blank for the default
# (openai/gpt-oss-20b). Groq retires models over time (llama-3.1-8b-instant was
# shut down Aug 16, 2026) -- if /ask starts failing with a 404, put a current
# model name from console.groq.com/docs/models here.
GROQ_MODEL=

# --- Optional features (each is skipped/disabled if left blank) ---

# Channel ID where new-member welcome messages get posted.
# Leave blank to disable the welcome message feature entirely.
WELCOME_CHANNEL_ID=your_welcome_channel_id_here

# The Manager role ID. Can use BOTH hidden commands: "?send <message>" and
# "?rolemenu" (which posts the self-assign roles menu).
# Leave blank to disable ?rolemenu entirely.
MANAGER_ROLE_ID=1532265448056422520

# A second, more limited role ID (e.g. a role named "Milo"). Can use
# "?send <message>" ONLY -- not "?rolemenu", which stays Manager-only.
# Leave blank if only the Manager role should be able to use ?send.
MILO_ROLE_ID=

# Self-assignable roles offered by /rolemenu, as:
#   ROLE_ID|Label|Emoji,ROLE_ID|Label|Emoji,...
# Emoji is optional per entry (just leave that segment blank: "ROLE_ID|Label|").
# A pipe "|" is used instead of a colon so custom emoji codes like
# <:Gamer:123456789012345678> (which already contain colons) parse cleanly.
# Leave blank to disable /rolemenu entirely.
# Example:
# SELF_ROLES=111111111111111111|Gamer|🎮,222222222222222222|Artist|🎨,333333333333333333|Night Owl|🦉
SELF_ROLES=

# --- Render-managed (usually don't set this yourself) ---

# Port for the built-in HTTP health server. Render sets this automatically.
PORT=10000
